{
  "rules": {
    "sojuRooms": {
      "$room": {
        ".read": "auth != null",
        ".write": "auth != null && (data.exists() ? data.child('glassUid').val() === auth.uid : newData.child('glassUid').val() === auth.uid)",
        ".validate": "$room.matches(/^[A-Z0-9]{6}$/) && newData.hasChildren(['glassUid', 'createdAt'])",
        "glassUid": {
          ".validate": "newData.isString() && (!data.exists() || newData.val() === data.val())"
        },
        "bottleUid": {
          ".write": "auth != null && newData.val() === auth.uid && (!data.exists() || data.val() === auth.uid || data.parent().child('bottleOnline').val() !== true)",
          ".validate": "newData.isString()"
        },
        "bottleOnline": {
          ".write": "auth != null && newData.parent().child('bottleUid').val() === auth.uid",
          ".validate": "newData.isBoolean()"
        },
        "pouring": {
          ".write": "auth != null && newData.parent().child('bottleUid').val() === auth.uid",
          ".validate": "newData.isBoolean()"
        },
        "aim": {
          ".write": "auth != null && newData.parent().child('bottleUid').val() === auth.uid",
          ".validate": "newData.isNumber()"
        },
        "tilt": {
          ".write": "auth != null && newData.parent().child('bottleUid').val() === auth.uid",
          ".validate": "newData.isNumber()"
        },
        "dir": {
          ".write": "auth != null && newData.parent().child('bottleUid').val() === auth.uid",
          ".validate": "newData.isNumber()"
        },
        "poured": {
          ".write": "auth != null && newData.parent().child('bottleUid').val() === auth.uid",
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000"
        },
        "amount": {
          ".write": "auth != null && newData.parent().child('bottleUid').val() === auth.uid && newData.val() === 0",
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 200"
        },
        "createdAt": { ".validate": "newData.isNumber()" },
        "glassOnline": { ".validate": "newData.isBoolean()" },
        "$other": { ".validate": false }
      }
    }
  }
}
